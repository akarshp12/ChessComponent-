    "files.eol": "auto",
    "files.trimTrailingWhitespace": true,
    "java.checkstyle.configuration": ".vscode/osu-cse-checkstyle-config.xml",
    "java.format.settings.url": ".vscode/osu-cse-formatter.xml",
    "java.format.settings.profile": "OSU CSE",
    "java.project.sourcePaths": [
        "src",
        "test"
    ],
    "java.project.outputPath": "bin",
    "java.project.referencedLibraries": {
        "include": [
            "lib/**/*.jar",
            "/Users/akarsh/Downloads/components.jar",
            "/Users/akarsh/Downloads/software-2-monorepo/lib/junit-4.13.2.jar",
            "/Users/akarsh/Downloads/software-2-monorepo 2/lib/BWClient.jar",
            "/Users/akarsh/Downloads/software-2-monorepo 2/lib/BWServer.jar",
            "/Users/akarsh/Downloads/software-2-monorepo 2/lib/components.jar",
            "/Users/akarsh/Downloads/software-2-monorepo 2/lib/hamcrest-core-1.3.jar",
            "/Users/akarsh/Downloads/software-2-monorepo 2/lib/junit-4.13.2.jar"
        ],
        "exclude": [
            "lib/components.jar"
        ]
    },
    "java.saveActions.cleanup": true,
    "java.cleanup.actions": [
        "qualifyMembers",
        "addOverride"
